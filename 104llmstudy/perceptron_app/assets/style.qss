QMainWindow {
    background: #151922;
}

QWidget {
    color: #e8eefc;
    background: #151922;
    font-size: 12px;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: 700;
    color: #f7fbff;
}

QPushButton {
    background: #2a5fff;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    color: white;
}

QPushButton:hover {
    background: #3b6cff;
}

QPushButton:disabled {
    background: #3b4258;
    color: #9aa3bd;
}

QTabWidget::pane {
    border: 1px solid #2d3446;
    border-radius: 12px;
    background: #1c2230;
}

QTabBar::tab {
    background: #242c3d;
    color: #d5def4;
    padding: 10px 16px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background: #2a5fff;
    color: white;
}

QGroupBox {
    border: 1px solid #313952;
    border-radius: 12px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: 600;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #313952;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    margin: -5px 0;
    background: #5bd5a8;
    border-radius: 8px;
}

QComboBox, QSpinBox, QDoubleSpinBox, QTableWidget, QTextEdit {
    background: #202738;
    border: 1px solid #313952;
    border-radius: 8px;
    padding: 6px;
}

QHeaderView::section {
    background: #283149;
    color: #f0f4ff;
    border: none;
    padding: 6px;
}

QFrame[card="true"] {
    background: #21283a;
    border: 1px solid #37405a;
    border-radius: 12px;
}
